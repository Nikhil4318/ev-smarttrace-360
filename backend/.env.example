PROJECT_NAME="EV SmartTrace 360"
VERSION="1.0.0"

# MySQL Database connection (Local or Managed Cloud MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ev_smarttrace

# JWT Secret Key for token signing
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# External AI & API Keys (Optional - Intelligent algorithmic fallbacks active)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPEN_CHARGE_MAP_API_KEY=your_open_charge_map_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
